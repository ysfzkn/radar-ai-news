# Anthropic API key used by the analysis step (not needed for `radar collect`).
ANTHROPIC_API_KEY=
# Path to the SQLite database file.
RADAR_DB_PATH=
# Telegram bot token used for notifications.
TELEGRAM_BOT_TOKEN=
# Telegram chat ID that receives notifications.
TELEGRAM_CHAT_ID=
# Hard daily spending cap in USD for model calls (defaults to 0.25 when unset).
RADAR_DAILY_CAP_USD=

# Anthropic API key used by the analysis step (not needed for `radar collect`).
ANTHROPIC_API_KEY=
# Path to the SQLite database file.
RADAR_DB_PATH=
# Telegram bot token used for notifications.
TELEGRAM_BOT_TOKEN=
# Telegram chat ID that receives notifications.
TELEGRAM_CHAT_ID=
# Hard daily spending cap in USD for model calls (defaults to 0.25 when unset).
RADAR_DAILY_CAP_USD=
# Base URL of the admin service that `radar push` sends stories to.
# RADAR_ADMIN_URL=
# Bearer token for `radar push` (the Worker's INGEST_TOKEN secret).
# RADAR_INGEST_TOKEN=
# Passphrase (at least 16 characters) that encrypts the database for `radar state save|load`.
# RADAR_STATE_KEY=
# SMTP server for e-mail notices from `radar daily` (e-mail is off when unset).
# RADAR_SMTP_HOST=
# SMTP port; STARTTLS is always used (defaults to 587).
# RADAR_SMTP_PORT=
# SMTP user name; login happens only when it is set.
# RADAR_SMTP_USER=
# SMTP password.
# RADAR_SMTP_PASSWORD=
# Sender address of the notice e-mail (defaults to the SMTP user).
# RADAR_MAIL_FROM=
# Recipient address of the notice e-mail.
# RADAR_MAIL_TO=

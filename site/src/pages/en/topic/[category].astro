---
import Base from "../../../layouts/Base.astro";
import StoryList from "../../../components/StoryList.astro";
import { COPY } from "../../../lib/copy";
import { loadData } from "../../../lib/data";
import { byCategory, forLang } from "../../../lib/editions";
import { categoryClass } from "../../../lib/format";
import { routes } from "../../../lib/routes";
import { CATEGORIES, type Category, type PublicStory } from "../../../lib/schema";

// Every category has a page, even with no stories yet.
export function getStaticPaths() {
  const groups = byCategory(forLang(loadData().stories, "en"));
  return CATEGORIES.map((category) => ({
    params: { category },
    props: { category, stories: groups.get(category) ?? [] },
  }));
}

interface Props {
  category: Category;
  stories: PublicStory[];
}

const lang = "en";
const { category, stories } = Astro.props;
const copy = COPY[lang];
const name = copy.categories[category];
---

<Base
  lang={lang}
  title={`${copy.topicTitle(name)} · ${copy.siteName}`}
  description={copy.tagline}
  path={routes[lang].topic(category)}
  alternate={routes.tr.topic(category)}
>
  <h1 class:list={["kunye label", categoryClass(category)]}>
    <span class="topic-tag caps">{name}</span>
  </h1>
  {stories.length > 0 ? <StoryList lang={lang} stories={stories} /> : <p class="empty">{copy.topicEmpty}</p>}
</Base>

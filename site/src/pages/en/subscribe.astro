---
import Base from "../../layouts/Base.astro";
import SubscribeView from "../../components/SubscribeView.astro";
import { COPY } from "../../lib/copy";
import { NEWSLETTER } from "../../lib/newsletter";
import { routes } from "../../lib/routes";

const lang = "en";
const copy = COPY[lang];
---

<Base
  lang={lang}
  title={`${copy.subscribeFree} · ${copy.siteName}`}
  description={NEWSLETTER.open ? copy.subscribe.mail.description : copy.subscribe.description}
  path={routes[lang].subscribe}
  alternate={routes.tr.subscribe}
>
  <SubscribeView lang={lang} />
</Base>

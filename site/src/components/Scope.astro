---
import { COPY } from "../lib/copy";
import { loadData } from "../lib/data";
import { anchorId, buildEditions, earlierStories, forLang, type Edition } from "../lib/editions";
import { categoryClass, shortDate } from "../lib/format";
import { GHOST_FEW, GHOST_LIMIT } from "../lib/nav";
import { storyLink } from "../lib/routes";
import StillToggle from "./StillToggle.astro";
import {
  BLIP_DOT,
  BLIP_HIT,
  RING_RADIUS,
  RING_SOURCES,
  blipPoint,
  placeBlips,
  shadowPoint,
  sweepStep,
  type Ring,
} from "../lib/scope";
import type { Lang } from "../lib/schema";

interface Props {
  lang: Lang;
  edition: Edition;
}

const { lang, edition } = Astro.props;
const copy = COPY[lang];
// An edition of fewer than five stories shows up to eight of the week's earlier ones, faint.
const ghosts = earlierStories(buildEditions(forLang(loadData().stories, lang)), edition, GHOST_FEW, GHOST_LIMIT);
// The day's stories first, so they keep the places they would have alone; the ghosts fit round them.
const placed = placeBlips([...edition.stories, ...ghosts.map((g) => g.story)]);
const blips = edition.stories.map((story, i) => {
  const { ring, angle } = placed[i];
  const { x, y } = blipPoint(ring, angle);
  const shade = shadowPoint(ring, angle);
  const no = String(i + 1).padStart(2, "0");
  const title = story.texts[lang]!.title;
  return {
    n: i + 1,
    no,
    title,
    ring,
    shade,
    href: `#${anchorId(story.uid)}`,
    cat: categoryClass(story.category),
    category: copy.categories[story.category],
    bearing: `${String(angle).padStart(3, "0")}°`,
    count: story.source_count,
    step: `sw-${sweepStep(angle)}`,
    transform: `translate(${x} ${y})`,
    sources: copy.sources(story.source_count),
  };
});
const faint = ghosts.map(({ date, story }, i) => {
  const { ring, angle } = placed[edition.stories.length + i];
  const { x, y } = blipPoint(ring, angle);
  return {
    n: i + 1,
    ring,
    href: storyLink(lang, date, story.uid),
    title: story.texts[lang]!.title,
    when: copy.scope.earlier(shortDate(date, lang)),
    transform: `translate(${x} ${y})`,
  };
});

// A polar point as path text, bearing 0 straight up and turning clockwise.
const at = (r: number, deg: number) => {
  const rad = (deg * Math.PI) / 180;
  return `${+(r * Math.sin(rad)).toFixed(2)} ${+(-r * Math.cos(rad)).toFixed(2)}`;
};
const marks = (every: number, from: number, to: number, skip = 0) =>
  Array.from({ length: 360 / every }, (_, i) => i * every)
    .filter((deg) => !skip || deg % skip !== 0)
    .map((deg) => `M${at(from, deg)}L${at(to, deg)}`)
    .join("");
// The face's fine graduation, every 5°, a longer mark every 30°, from its edge inward.
const minor = marks(5, 99, 96, 30);
const major = marks(30, 99, 92);
// The bezel's: every 10° on its inner band, every 30° longer; and its bearings, every 30°.
const bezelMinor = marks(10, 102, 104.4, 30);
const bezelMajor = marks(30, 101.6, 105.6);
const bearings = Array.from({ length: 12 }, (_, i) => {
  const [x, y] = at(110.4, i * 30).split(" ");
  return { x, y, text: String(i * 30).padStart(3, "0") };
});
// Outermost first: each ring is a layer of its own, the inner ones nearer the reader.
const rings: Ring[] = [3, 2, 1];
---

{/*
  The instrument and its readout panel. Every blip is a link to its story. Without a stylesheet
  the `hidden` attributes keep both out of the way and the plain list under them (EditionIndex) is
  the index; the stylesheet shows the scope, and the panel beside it from 48rem.
*/}
<div class="scope-rail">
  <section class="scope" aria-labelledby="scope-label" hidden>
    <p class="scope-head label caps">
      <span id="scope-label">{copy.scope.label}</span>
      <span class="scope-count">{copy.storyCount(blips.length)}</span>
    </p>
    {/*
      A radar display seen from above at an angle: a body with a wall (slices one under another), its
      shadow on the ground, a bezel ring with bearings, a glass face with its graduation, a sweep and
      a gleam, and over the face the ring layers and the blips, each standing on a stem above its
      shadow, the louder the taller.
    */}
    <div class="scope-stage">
      <div class="scope-dish" data-scope-dish>
        <i class="dish-floor"></i>
        <i class="dish-wall w-6"></i>
        <i class="dish-wall w-5"></i>
        <i class="dish-wall w-4"></i>
        <i class="dish-wall w-3"></i>
        <i class="dish-wall w-2"></i>
        <i class="dish-wall w-1"></i>
        <svg class="scope-plate" viewBox="-100 -100 200 200" aria-hidden="true">
          <circle class="plate-face" r="100"></circle>
          <defs>
            <radialGradient id="scope-glass" cx="0.4" cy="0.34" r="0.72">
              <stop class="glass-0" offset="0"></stop>
              <stop class="glass-1" offset="0.7"></stop>
              <stop class="glass-2" offset="1"></stop>
            </radialGradient>
            <radialGradient id="scope-shade">
              <stop class="shade-0" offset="0"></stop>
              <stop class="shade-1" offset="1"></stop>
            </radialGradient>
          </defs>
          <path class="plate-cross" d="M-99 0H99M0 -99V99"></path>
          {/* Where each ring would meet the plate: its raised layer stands above this trace. */}
          {rings.map((ring) => <circle class="ring-trace" r={RING_RADIUS[ring]}></circle>)}
          <path class="plate-minor" d={minor}></path>
          <path class="plate-major" d={major}></path>
          {blips.map((blip) => <circle class={`blip-shade ${blip.cat}`} cx={blip.shade.x} cy={blip.shade.y} r="9"></circle>)}
        </svg>
        <div class="scope-sweep" aria-hidden="true"></div>
        <i class="dish-glass"></i>
        <svg class="scope-bezel" viewBox="-116 -116 232 232" aria-hidden="true">
          <defs>
            <linearGradient id="scope-metal" x1="0.15" y1="0" x2="0.85" y2="1">
              <stop class="metal-0" offset="0"></stop>
              <stop class="metal-1" offset="0.45"></stop>
              <stop class="metal-2" offset="1"></stop>
            </linearGradient>
            <linearGradient id="scope-lip" x1="0.15" y1="0" x2="0.85" y2="1">
              <stop class="lip-0" offset="0"></stop>
              <stop class="lip-1" offset="1"></stop>
            </linearGradient>
          </defs>
          <circle class="bezel-body" r="108"></circle>
          <circle class="bezel-edge" r="115.4"></circle>
          <circle class="bezel-lip" r="100.8"></circle>
          <path class="bezel-minor" d={bezelMinor}></path>
          <path class="bezel-major" d={bezelMajor}></path>
          <g class="bezel-bearings">
            {bearings.map((b) => <text x={b.x} y={b.y}>{b.text}</text>)}
          </g>
          <path class="bezel-index" d="M0 -101.2L-2.6 -105.8H2.6Z"></path>
        </svg>
        {
          rings.map((ring) => (
            <svg class={`scope-layer layer-${ring}`} viewBox="-100 -100 200 200">
              <g aria-hidden="true">
                <circle class="ring" r={RING_RADIUS[ring]}></circle>
                <text class="ring-label" x="2.5" y={-RING_RADIUS[ring] + 6.5}>
                  {RING_SOURCES[ring]}
                </text>
              </g>
            </svg>
          ))
        }
        {/*
          The blips in story order, each a layer of its own at its ring's height: the document (and
          so Tab and a screen reader) follows the edition, 01, 02, 03 …; ring and bearing are only
          where a blip is drawn. A blip's head is drawn taller than round (blip-up), so that seen at
          the dish's angle it faces the reader.
        */}
        {
          blips.map((blip) => (
            <svg class={`scope-layer layer-${blip.ring}`} viewBox="-100 -100 200 200"><a class={`blip b-${blip.n} ${blip.cat} ${blip.step}`} href={blip.href} aria-labelledby={`scope-t-${blip.n}`}>
                <g transform={blip.transform}>
                  <path class="blip-stem" d="M0 0V1"></path>
                  <g class="blip-up">
                    <circle class="blip-hit" r={BLIP_HIT}></circle>
                    <circle class="blip-echo" r={BLIP_DOT}></circle>
                    <circle class="blip-dot" r={BLIP_DOT}></circle>
                    <ellipse class="blip-shine" cx="-2.3" cy="-3" rx="2.8" ry="1.7"></ellipse>
                    <text class="blip-no">{blip.no}</text>
                  </g>
                </g>
              </a></svg>
          ))
        }
        {/*
          A thin edition keeps company: stories of the week's earlier editions as small, faint
          ghosts after the day's own blips, each a link to its story on its own edition, named as
          earlier ("Önceki baskı, 18 Kas: …").
        */}
        {
          faint.map((ghost) => (
            <svg class={`scope-layer layer-${ghost.ring}`} viewBox="-100 -100 200 200"><a class={`ghost g-${ghost.n}`} href={ghost.href} aria-labelledby={`scope-g-${ghost.n}`}>
                <g transform={ghost.transform}>
                  <g class="blip-up">
                    <circle class="blip-hit" r={BLIP_HIT}></circle>
                    <circle class="ghost-dot" r="4"></circle>
                  </g>
                </g>
              </a></svg>
          ))
        }
      </div>
    </div>
    {/*
      The readout: the title of the blip under the pointer or focus, else of the one the sweep passed
      last. It is hidden from assistive tech as a whole, but each line is its blip's accessible name
      (aria-labelledby reads hidden text), so no title has to go into an attribute.
    */}
    <p class="scope-readout" aria-hidden="true">
      <span class="readout-idle">{copy.scope.idle}</span>
      {
        blips.map((blip) => (
          <span class={`readout-line t-${blip.n} ${blip.cat} ${blip.step}`} id={`scope-t-${blip.n}`}>
            <span class="readout-no">{blip.no}</span> {blip.title}{" "}
            <span class="visually-hidden">({blip.sources})</span>
          </span>
        ))
      }
      {
        faint.map((ghost) => (
          <span class={`readout-ghost u-${ghost.n}`} id={`scope-g-${ghost.n}`}>
            <span class="readout-when">{ghost.when}</span> {ghost.title}
          </span>
        ))
      }
    </p>
    <p class="scope-caption label">{copy.scope.caption}</p>
    <p class="scope-still"><StillToggle lang={lang} /></p>
  </section>
  {/*
    The readout panel: one row per story, its number, bearing, sources, topic and title, each a
    link to the story. It repeats the blips for the eye only, so it is hidden from assistive tech
    and out of the tab order; the blips are the instrument's links. A row and its blip light
    each other (CSS).
  */}
  <div class="scope-panel label" aria-hidden="true" hidden>
    <p class="panel-head caps"><span>{copy.scope.panel}</span><span>{edition.date}</span></p>
    <p class="panel-cols panel-grid caps">{copy.scope.columns.map((c) => <span>{c}</span>)}</p>
    <ol class="panel-rows" role="list">
      {
        blips.map((blip) => (
          <li>
            <a class={`panel-row panel-grid r-${blip.n}`} href={blip.href} tabindex="-1">
              <span class="pr-no">{blip.no}</span>
              <span>{blip.bearing}</span>
              <span>{blip.count}</span>
              <span class="caps">{blip.category}</span>
              <span class="pr-title">{blip.title}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</div>

<script>
  import "../scripts/scope";
  import "../scripts/reading";
</script>

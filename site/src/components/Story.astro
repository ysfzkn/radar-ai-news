---
import Echo from "./Echo.astro";
import { COPY } from "../lib/copy";
import { anchorId } from "../lib/editions";
import { categoryClass, hostLabel, httpUrl, shortDate } from "../lib/format";
import { EXTERNAL, routes } from "../lib/routes";
import type { Lang, PublicStory, Source } from "../lib/schema";

interface Props {
  lang: Lang;
  story: PublicStory;
  /** 1-based position in the edition. */
  index: number;
  /** The edition's "YYYY-MM-DD". */
  date: string;
  /** The first story of an edition page, set larger. */
  lead?: boolean;
  /** Show the date in the label row: on week pages, where stories come from several days. */
  showDate?: boolean;
}

const SOURCE_LIMIT = 4;

const { lang, story, index, date, lead = false, showDate = false } = Astro.props;
const copy = COPY[lang];
const text = story.texts[lang]!;

// The main source first, by its name if the list has it, else by its host.
const listed: Source[] = story.sources.filter((source) => httpUrl(source.url) !== null);
const mainUrl = httpUrl(story.source_url);
const main = listed.find((source) => source.url === story.source_url);
const sources: Source[] = mainUrl
  ? [main ?? { name: hostLabel(mainUrl), url: mainUrl }, ...listed.filter((s) => s !== main)]
  : listed;
const shown = sources.slice(0, SOURCE_LIMIT);
const more = sources.length - shown.length;

const tryUrl = httpUrl(story.try_url);
const id = anchorId(story.uid);
const no = String(index).padStart(2, "0");
---

<article id={id} class:list={["story", { "story-lead": lead }, categoryClass(story.category)]}>
  <p class="story-meta label">
    <a class="story-no" href={`#${id}`} aria-label={copy.storyLink(no)}>{no}</a>{" "}
    <a class="story-cat caps" href={routes[lang].topic(story.category)}>{copy.categories[story.category]}</a>{" "}
    {showDate && <time datetime={date}>{shortDate(date, lang)}</time>}{" "}
    <Echo lang={lang} count={story.source_count} />
  </p>
  <h2 class="story-title">{text.title}</h2>
  <p class="story-summary">{text.summary}</p>
  <p class="story-why"><span class="why-label label caps">{copy.whyItMatters}</span> {text.dev_line}</p>
  {
    shown.length > 0 && (
      <p class="story-sources label">
        {copy.sourceLabel}{" "}
        {shown.map((source, i) => (
          <>
            {i > 0 && " · "}
            <a href={source.url} {...EXTERNAL}>
              {source.name}
            </a>
          </>
        ))}
        {more > 0 && ` · +${more}`}
      </p>
    )
  }
  {
    tryUrl && (
      <p class="story-try label">
        <a class="try" href={tryUrl} {...EXTERNAL}>
          <span class="story-try-mark" aria-hidden="true">▸</span> {copy.tryIt}{" "}<span class="try-host">{hostLabel(tryUrl)}</span>
        </a>
      </p>
    )
  }
</article>

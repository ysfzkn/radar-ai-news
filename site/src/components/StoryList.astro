---
import Echo from "./Echo.astro";
import { COPY } from "../lib/copy";
import { istanbulDate } from "../lib/editions";
import { categoryClass, shortDate } from "../lib/format";
import { storyLink } from "../lib/routes";
import type { Lang, PublicStory } from "../lib/schema";

interface Props {
  lang: Lang;
  /** In the order to show; each story's edition date is its Istanbul day. */
  stories: PublicStory[];
}

const { lang, stories } = Astro.props;
const copy = COPY[lang];
---

<ol class="list" role="list">
  {
    stories.map((story) => {
      const date = istanbulDate(story.published_at);
      return (
        <li class={categoryClass(story.category)}>
          <p class="story-meta label">
            <time datetime={date}>{shortDate(date, lang)}</time>{" "}
            <span class="story-cat caps">{copy.categories[story.category]}</span>{" "}
            <Echo lang={lang} count={story.source_count} />
          </p>
          <h2 class="list-title">
            <a href={storyLink(lang, date, story.uid)}>{story.texts[lang]!.title}</a>
          </h2>
        </li>
      );
    })
  }
</ol>

---
import Mark from "./Mark.astro";
import { COPY } from "../lib/copy";
import { EXTERNAL, OWNER, routes } from "../lib/routes";
import type { Lang } from "../lib/schema";

interface Props {
  lang: Lang;
  /** This page's address, to mark the current link. */
  path: string;
  /** The same page in the other language, or null to point at its home. */
  alternate: string | null;
}

const { lang, path, alternate } = Astro.props;
const copy = COPY[lang];
const other: Lang = lang === "tr" ? "en" : "tr";
const languages: Lang[] = ["tr", "en"];
const links = [
  { href: routes[lang].home, text: copy.nav.today },
  { href: routes[lang].archive, text: copy.nav.archive },
  { href: routes[lang].weekIndex, text: copy.nav.week },
  { href: routes[lang].about, text: copy.nav.about },
];
const subscribe = routes[lang].subscribe;
---

{/* Two rows: the name and whose it is, with the subscribe button; then the links and the language switch. */}
<header class="top">
  <div class="top-id">
    <a class="wordmark" href={routes[lang].home}>
      <Mark />
      {copy.siteName}
    </a>
    <a class="by label" href={OWNER.site} {...EXTERNAL}>{copy.by}</a>
  </div>
  <div class="top-act">
    <button class="pal-open label" type="button" data-palette-open hidden aria-label={copy.palette.open}>
      <kbd>⌘K</kbd><span class="pal-open-word">{copy.palette.hint}</span>
    </button>
    <a class="subscribe label" href={subscribe} aria-current={subscribe === path ? "page" : undefined}>
      {copy.subscribeFree}
    </a>
  </div>
  <nav class="top-nav">
    <ul class="nav label">
      {
        links.map((link) => (
          <li>
            <a href={link.href} aria-current={link.href === path ? "page" : undefined}>
              {link.text}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="lang label" role="group" aria-label={copy.language}>
      {
        languages.map((code) =>
          code === lang ? (
            <span class="lang-part" aria-current="true">{COPY[code].langShort}</span>
          ) : (
            <a class="lang-part" href={alternate ?? routes[other].home} hreflang={other} lang={other}>
              {COPY[code].langShort}
            </a>
          ),
        )
      }
    </div>
  </nav>
</header>

---
interface Props {
  /** How many arcs, from the left, are lit: 0 to 5. */
  level: number;
  /** Rendered size in px; the drawing is 44 × 14. */
  width?: number;
  height?: number;
  /** With a label the arcs are an image with that name; without one they are decoration. */
  label?: string;
}

const { level, width = 44, height = 14, label } = Astro.props;
// Five equal arcs side by side, each bulging to the right; the first `level` are lit.
const arcs = [2, 10.5, 19, 27.5, 36].map((x, i) => ({
  d: `M${x} 1.5A8.5 8.5 0 0 1 ${x} 12.5`,
  on: i < level,
}));
---

<svg
  class="echo-arcs"
  viewBox="0 0 44 14"
  width={width}
  height={height}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  {arcs.map((arc) => <path class={arc.on ? "echo-on" : "echo-off"} d={arc.d} />)}
</svg>

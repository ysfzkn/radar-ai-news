---
// The top of the home page: the edition's dateline (the page's one h1), the two promises as its
// slogan, what Radar is in one line, and a quiet link, beside the day's radar (Scope.astro: the edition's stories as blips, each a link to its
// story below). On a wide screen the words stand left and the radar right; on a phone the words
// come first and the radar under them, tipped further back so it is wide and low. The stories
// follow at once.
import EditionMasthead from "./EditionMasthead.astro";
import Scope from "./Scope.astro";
import { COPY } from "../lib/copy";
import type { Edition } from "../lib/editions";
import { routes } from "../lib/routes";
import type { Lang } from "../lib/schema";

interface Props {
  lang: Lang;
  /** The newest edition, whose stories are the radar's blips; null on a site without one. */
  edition: Edition | null;
}

const { lang, edition } = Astro.props;
const { hero } = COPY[lang];
const [before, marked, after] = hero.lead;
---

<section class="hero" aria-labelledby="hero-lead">
  <div class="hero-copy">
    {
      edition ? (
        <EditionMasthead lang={lang} edition={edition} />
      ) : (
        <p class="hero-label label caps"><span class="hero-arcs" aria-hidden="true">)))</span> {hero.label}</p>
      )
    }
    <p class="hero-slogan"><span>{hero.promises[0]}<span class="hero-stop">.</span></span> <span>{hero.promises[1]}<span class="hero-stop">.</span></span></p>
    <p class="hero-lead" id="hero-lead">{before}<em class="hero-mark">{marked}</em>{after}</p>
    <p class="hero-more label"><a href={routes[lang].about}>{hero.more} <span aria-hidden="true">→</span></a></p>
  </div>
  {edition && <div class="hero-radar"><Scope lang={lang} edition={edition} /></div>}
</section>

---
import { COPY } from "../lib/copy";
import { NEWSLETTER } from "../lib/newsletter";
import { EXTERNAL } from "../lib/routes";
import type { Lang } from "../lib/schema";

interface Props {
  lang: Lang;
}

const about = COPY[Astro.props.lang].about;
const mail = COPY[Astro.props.lang].subscribe.mail;
---

<h1 class="kunye label"><span class="kunye-no">{about.title}</span></h1>

<div class="prose">
  {
    about.sections.map((section) => (
      <section>
        <h2>{section.heading}</h2>
        {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
        {section.privacy && NEWSLETTER.open && <p>{mail.privacy}</p>}
        {section.steps && (
          <ol class="steps">
            {section.steps.map((step) => (
              <li>
                <strong>{step.name}.</strong> {step.text}
              </li>
            ))}
          </ol>
        )}
        {section.after?.map((paragraph) => <p>{paragraph}</p>)}
        {section.links && (
          <p>
            {section.links.map((link, i) => (
              <>
                {i > 0 && " · "}
                <a href={link.href} {...EXTERNAL}>
                  {link.text}
                </a>
              </>
            ))}
          </p>
        )}
      </section>
    ))
  }
</div>

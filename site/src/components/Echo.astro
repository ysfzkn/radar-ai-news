---
import EchoArcs from "./EchoArcs.astro";
import { COPY } from "../lib/copy";
import { echoLevel } from "../lib/editions";
import type { Lang } from "../lib/schema";

interface Props {
  lang: Lang;
  count: number;
}

const { lang, count } = Astro.props;
const level = echoLevel(count);
---

<span class="echo">
  <EchoArcs level={level} label={COPY[lang].echoLabel(level, count)} />
  <span aria-hidden="true">{COPY[lang].sources(count)}</span>
</span>

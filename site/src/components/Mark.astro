---
interface Props {
  /** Width and height in px. */
  size?: number;
  /** With a label the mark is an image with that name; without one it is decoration. */
  label?: string;
}

const { size = 20, label } = Astro.props;
// Radar's mark: a radar screen. A ring, a sweep from the centre to the top-right, and one
// blip at the lower left. Colour is CSS only.
---

<svg
  class="mark"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  <circle class="mark-ring" cx="12" cy="12" r="9.25"></circle>
  <line class="mark-sweep" x1="12" y1="12" x2="18.54" y2="5.46"></line>
  <circle class="mark-blip" cx="7.75" cy="14.25" r="1.9"></circle>
</svg>

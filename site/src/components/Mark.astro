---
interface Props {
  /** Width and height in px. */
  size?: number;
  /** With a label the mark is an image with that name; without one it is decoration. */
  label?: string;
}

const { size = 20, label } = Astro.props;
// Radar's mark: three of the echo meter's arcs, side by side, each bulging to the right.
const arcs = [5, 11, 17].map((x) => `M${x} 4A13 13 0 0 1 ${x} 20`);
---

<svg
  class="mark"
  viewBox="0 0 24 24"
  width={size}
  height={size}
  role={label ? "img" : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : "true"}
>
  {arcs.map((d) => <path class="mark-arc" d={d} />)}
</svg>

---
import { COPY } from "../lib/copy";
import type { Lang } from "../lib/schema";

interface Props {
  lang: Lang;
}

const motion = COPY[Astro.props.lang].motion;
---

{/*
  The pause for looping motion (WCAG 2.2.2): one state for the whole page, the class `still` on
  <html>, which boot.js toggles from any button marked `data-still` and remembers for the browser
  session. Without script nothing loops and the button stays hidden; the stylesheet shows it only
  with script and with motion to stop. It reads what a press does: "durdur" while the motion runs,
  "başlat" once it is stopped (the stylesheet swaps the two words by the class).
*/}
<button class="still-toggle label" type="button" data-still hidden><span class="still-pause">{motion.pause}</span><span class="still-play">{motion.play}</span></button>

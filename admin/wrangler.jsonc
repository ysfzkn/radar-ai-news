{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radar-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "radar",
      // Placeholder: replace with the id printed by `wrangler d1 create radar`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "radar-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "radar",
      // The production database (`wrangler d1 create radar`). Not a secret.
      "database_id": "f7781091-ffc4-4ec2-bec5-f8a8bd990f36",
      // Local development keeps its own database under this id (see docs/admin.md).
      "preview_database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["17 * * * *"]
  }
}
